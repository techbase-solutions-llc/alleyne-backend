{
    "attributes": {
        "username": {
            "type": "string",
            "minLength": 3,
            "unique": true,
            "configurable": false,
            "required": true
        },
        "email": {
            "type": "email",
            "configurable": false,
            "required": true
        },
        "provider": {
            "type": "string",
            "configurable": false
        },
        "password": {
            "type": "password",
            "configurable": false,
            "private": true
        },
        "resetPasswordToken": {
            "type": "string",
            "configurable": false,
            "private": true
        },
        "confirmationToken": {
            "type": "string",
            "configurable": false,
            "private": true
        },
        "confirmed": {
            "type": "boolean",
            "default": false,
            "configurable": false
        },
        "blocked": {
            "type": "boolean",
            "default": false,
            "configurable": false
        },
        "role": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "plugin::users-permissions.role",
            "inversedBy": "users",
            "configurable": false
        },
        "role_type": {
            "type": "enumeration",
            "enum": [
                "guest",
                "host",
                "agent",
                "agency"
            ],
            "default": "guest"
        },
        "avatar": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ]
        },
        "bio": {
            "type": "text"
        },
        "phone": {
            "type": "string"
        },
        "whatsappNumber": {
            "type": "string"
        },
        "website": {
            "type": "string"
        },
        "verification_status": {
            "type": "enumeration",
            "enum": [
                "unverified",
                "pending",
                "verified"
            ],
            "default": "unverified"
        },
        "agency": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::agency.agency",
            "inversedBy": "agents"
        },
        "marketingOptIn": {
            "type": "boolean",
            "default": false
        },
        "marketingOptInAt": {
            "type": "datetime"
        }
    }
}
